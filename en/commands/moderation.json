      "member": { "description": "Who to release from jail." },
      "reason": { "description": "Add a reason." }
    }
  },
  "kick": {
    "description": "Kicks a member from the server.",
    "options": {
      "member": { "description": "Who to kick." },
      "reason": { "description": "Add a reason." }
    }
  },
  "lock": {
    "description": "Locks and unlocks a channel.",
