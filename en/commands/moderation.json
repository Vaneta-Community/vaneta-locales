      "user": { "description": "Who to ban." },
      "reason": { "description": "Add a reason." }
    }
  },
  "ban remove": {
    "description": "Unbans a user from the server.",
    "options": {
      "user": { "description": "Who to unban." },
      "reason": { "description": "Add a reason." }
    }
  },
  "giveaway create": {
    "description": "Creates a giveaway.",
