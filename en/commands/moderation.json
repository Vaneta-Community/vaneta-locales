{
  "announce": {
    "description": "Sends an embedded announcement message as the bot.",
    "options": {
      "message": { "description": "The announcement message." },
      "mention": { "description": "What role to ping." }
    }
  },
  "ban add": {
    "description": "Bans a user from the server.",
